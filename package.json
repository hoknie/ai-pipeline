{
  "name": "@hoknie/aip",
  "version": "0.5.0",
  "description": "aip: local orchestrator for a swarm of AI agents (Claude Code, OpenCode)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoknie/ai-pipeline.git"
  },
  "homepage": "https://github.com/hoknie/ai-pipeline#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "aip": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "templates",
    ".claude-plugin",
    "integrations/claude-code",
    "!integrations/claude-code/test"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run --project unit --project web --maxWorkers=3 && AIP_E2E=golden vitest run --project e2e --maxWorkers=3",
    "test:full": "vitest run --project unit --project web --maxWorkers=3 && vitest run --project e2e --maxWorkers=3",
    "test:e2e": "vitest run --project e2e --maxWorkers=3",
    "test:browser": "node web/browser/run.ts test",
    "test:browser:install": "node web/browser/run.ts install chromium",
    "format": "prettier --write .",
    "check": "prettier --check . && tsc -p tsconfig.json && tsc -p web/tsconfig.json && npm test",
    "check:full": "prettier --check . && tsc -p tsconfig.json && tsc -p web/tsconfig.json && npm run test:full"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@node-saml/node-saml": "5.2.0",
    "commander": "15.0.0",
    "openid-client": "6.9.0",
    "ws": "8.23.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@plantuml/core": "1.2026.10",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/hast": "3.0.5",
    "@types/markdown-it": "14.2.0",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "@viz-js/viz": "3.31.0",
    "@xmldom/xmldom": "0.9.12",
    "@xyflow/react": "12.12.0",
    "beautiful-mermaid": "1.1.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "i18next": "26.6.0",
    "jsdom": "30.1.3",
    "lowlight": "3.3.0",
    "lucide-react": "1.66.0",
    "markdown-it": "14.3.3",
    "oxc-parser": "0.157.0",
    "prettier": "3.9.10",
    "prosemirror-commands": "1.7.1",
    "prosemirror-history": "1.5.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.2",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.7",
    "prosemirror-view": "1.44.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.10",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "xml-crypto": "6.4.0"
  }
}
